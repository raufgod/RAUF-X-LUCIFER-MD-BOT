# RAUF × LUCIFER MD BOT - single server (website, admin panel, Telegram, main bot)
TELEGRAM_BOT_TOKEN=
PAIRING_NUMBER=
OWNER_NUMBER=
CUSTOM_PAIRING_CODE=

OWNER_NUMBER_2=

# Telegram admin chat IDs (comma separated) - only these see the Admin button
TELEGRAM_ADMIN_IDS=

# Website password bot token (the admin link does not need it)
TELEGRAM_PASSWORD_BOT_TOKEN=
# optional: WEB_GATE=false (force lock off), WEB_GATE_SESSION_HOURS=12
GROUP_LINK=

# Your own domain (no ngrok). Point the domain to this server's port, then write it here, e.g. SITE_DOMAIN=example.com
SITE_DOMAIN=

# Cloudflare Tunnel token (the long text starting with eyJ...). The bot starts cloudflared by itself.
CLOUDFLARE_TUNNEL_TOKEN=

# Voice agent (Arya) - see docs/voice-agent.md
# GROQ_API_KEY: free key from console.groq.com, only needed so Arya can understand voice replies
GROQ_API_KEY=
CALL_ADMIN_SECRET=

# Admin panel: open https://YOUR-DOMAIN/<this code>  (8-64 letters/digits/-/_). Change it to your own secret!
ADMIN_CODE=
